# ============================================================
# El Barril — backend (.env)
# Copiar a .env real, NO commitear el .env real al repo.
# Valores SUPABASE_* son los MISMOS que usa kalreco_backend
# (ver infra/docker-compose.yml del repo kalreco) — misma BD.
# Los JWT_SECRET / JWT_REFRESH_SECRET son PROPIOS de El Barril,
# nunca reutilizar los de kalreco_backend (evita que un token
# emitido por Kalreco sirva para entrar acá).
# ============================================================

NODE_ENV=production
PORT=4001

# ── Supabase (misma instancia que Kalreco) ────────────────────
SUPABASE_URL=http://supabase-kong:8000
SUPABASE_PUBLIC_URL=https://supabase.mymulticentro.com
SUPABASE_SERVICE_ROLE_KEY=<< copiar de kalreco/infra/docker-compose.yml >>
SUPABASE_ANON_KEY=<< copiar de kalreco/infra/docker-compose.yml >>

# ── JWT — EXCLUSIVOS de El Barril, no reutilizar los de Kalreco ─
JWT_SECRET=aeb153c80b8e5d0278bc166d43d19fffb6fd96b3cf3dd74ecca19e689c43e06f
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=76bf8b7593cc8c8bb43ae45c0962adf235f7822aa743b6dbc1f5bb11e1b838fe
JWT_REFRESH_EXPIRES_IN=7d

# ── Frontend / CORS ─────────────────────────────────────────────
FRONTEND_URL=https://elbarril.mymulticentro.com

# ── Storage (mismo bucket compartido) ──────────────────────────
STORAGE_BUCKET=kalreco-media
MAX_FILE_SIZE=5242880

TZ=America/Bogota
